# Attorno - variabili d'ambiente di esempio.
# Copia in .env.local per lo sviluppo. Non inserire mai segreti in questo file.
# La Fase 01A non richiede credenziali: nessun database, auth, mappa o servizio esterno.

# URL pubblico del sito, usato per i metadata (canonical, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo per test/sviluppo (lato server): fissa l'orologio del catalogo DEMO.
# Formato obbligatorio: istante UTC ISO 8601 con "Z" (es. 2026-10-23T08:00:00.000Z).
# Ignorato se il valore non è valido o se il territorio attivo non è DEMO.
# Lasciare vuoto per usare l'ora corrente. Non impostarlo in produzione.
ATTORNO_DEMO_NOW=

# Mappa (Fase 01D). Senza chiave la mappa mostra un messaggio e la lista resta completa.
# MAP_PROVIDER: "maptiler" (predefinito) oppure "none" per disattivare la mappa.
MAP_PROVIDER=maptiler
# Chiave PUBBLICA MapTiler (finisce nel browser). Limitarla ai domini del sito nel pannello
# MapTiler (Allowed HTTP origins). Mai usare qui credenziali private o con privilegi.
MAPTILER_PUBLIC_KEY=
# Stile cartografico MapTiler (opzionale), es. streets-v2, basic-v2.
MAPTILER_MAP_ID=streets-v2

# Solo sviluppo: gli IP di rete locale di questo PC sono gia ammessi in automatico.
# Qui eventuali hostname aggiuntivi da cui aprire `npm run dev` (es. un tunnel).
# Separati da virgola, senza http:// ne porta.
NEXT_DEV_ALLOWED_ORIGINS=
